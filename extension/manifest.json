{
  "manifest_version": 3,
  "name": "TraceX Website Blocker",
  "version": "1.1",
  "description": "Blocks distracting websites and syncs the blocked-site list with TraceX.",
  "permissions": ["tabs", "storage", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://tracex-gdbl.vercel.app/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": { "default_popup": "popup.html" },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
